# Healthcare Appointment & Follow-up Manager
# Copy to .env for local development. Values are placeholders or disposable local
# defaults only. Never commit .env, tokens, provider keys, or PHI.

# ---------------------------------------------------------------------------
# Browser-safe Next.js configuration (apps/web)
# ---------------------------------------------------------------------------
# Use either NEXT_PUBLIC_API_URL (including /api/v1) or NEXT_PUBLIC_API_BASE_URL
# (the API origin). The web client resolves both forms and appends /api/v1 when
# needed. Demo mode is an explicit in-memory fixture mode, not hosted API mode.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# ---------------------------------------------------------------------------
# FastAPI process (apps/api)
# ---------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://healthcare:healthcare@localhost:5432/healthcare
HOLD_TTL_SECONDS=600
READINESS_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO

# Supabase-compatible JWT verification. The public-key path is preferred for
# hosted deployments. SUPABASE_JWT_SECRET is retained only for an explicitly
# reviewed HS256 deployment; leave it blank in this template.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
# Local seeded subjects may use test:<subject> only in local/development/test.
# Hosted production must set this to false.
AUTH_ALLOW_LOCAL_TEST_TOKENS=true

# ---------------------------------------------------------------------------
# Durable worker and PostgreSQL outbox poller (apps/worker)
# ---------------------------------------------------------------------------
# Worker settings are intentionally prefixed. The worker does not implicitly
# load the root dotenv file; export these values or configure the process manager.
HEALTHCARE_WORKER_SERVICE_NAME=healthcare-worker
HEALTHCARE_WORKER_ENVIRONMENT=development
HEALTHCARE_WORKER_DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/healthcare
HEALTHCARE_WORKER_BROKER_URL=redis://localhost:6379/0
HEALTHCARE_WORKER_RESULT_BACKEND_URL=redis://localhost:6379/1
HEALTHCARE_WORKER_EVENT_VERSION=1
HEALTHCARE_WORKER_MAX_RETRIES=5
HEALTHCARE_WORKER_RETRY_BASE_DELAY_SECONDS=5
HEALTHCARE_WORKER_RETRY_MAX_DELAY_SECONDS=900
HEALTHCARE_WORKER_RETRY_JITTER_SECONDS=3
HEALTHCARE_WORKER_TASK_QUEUE=healthcare-worker
HEALTHCARE_WORKER_OUTBOX_POLL_INTERVAL_SECONDS=2
HEALTHCARE_WORKER_OUTBOX_BATCH_SIZE=50
HEALTHCARE_WORKER_OUTBOX_LEASE_SECONDS=120
HEALTHCARE_WORKER_MAX_CONCURRENCY=10
HEALTHCARE_WORKER_PROVIDER_TIMEOUT_SECONDS=10

# Provider adapter configuration. Blank credentials/endpoints intentionally
# produce safe pending/failed integration state; they never invalidate a commit.
HEALTHCARE_WORKER_SENDGRID_API_KEY=
HEALTHCARE_WORKER_SENDGRID_FROM_EMAIL=notifications@example.invalid
HEALTHCARE_WORKER_SENDGRID_ENDPOINT=https://api.sendgrid.com/v3/mail/send

HEALTHCARE_WORKER_GOOGLE_CLIENT_ID=
HEALTHCARE_WORKER_GOOGLE_CLIENT_SECRET=
HEALTHCARE_WORKER_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
HEALTHCARE_WORKER_GOOGLE_CALENDAR_ENDPOINT=https://www.googleapis.com/calendar/v3

HEALTHCARE_WORKER_LLM_ENDPOINT=
HEALTHCARE_WORKER_LLM_API_KEY=
HEALTHCARE_WORKER_LLM_PROVIDER=generic
HEALTHCARE_WORKER_LLM_MODEL=
HEALTHCARE_WORKER_LLM_PROMPT_VERSION=clinical.v1
HEALTHCARE_WORKER_LLM_SCHEMA_VERSION=clinical.v1
HEALTHCARE_WORKER_LLM_VALIDATION_RETRIES=2

# Local-only operator metadata. Loading infra/seed-demo.sql remains explicit.
SEED_DEMO_DATA=false
