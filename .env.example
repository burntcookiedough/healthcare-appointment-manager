# Healthcare Appointment & Follow-up Manager
# Copy to .env for local development. Every value below is a placeholder or a
# disposable local default. Never commit .env, tokens, provider keys, or PHI.

# ---------------------------------------------------------------------------
# Browser-safe web configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# ---------------------------------------------------------------------------
# FastAPI process (apps/api)
# ---------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://healthcare:healthcare@localhost:5432/healthcare
HOLD_TTL_SECONDS=600
READINESS_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO

# Phase 1 can resolve a local seeded actor subject from a bearer token. Supabase
# JWT verification and profile provisioning are a later API lane; leave these
# placeholders empty until that lane is integrated.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-verification-secret

# ---------------------------------------------------------------------------
# Redis/Celery transport
# ---------------------------------------------------------------------------
# The API foundation does not call Redis. The worker reads the explicit
# HEALTHCARE_WORKER_* names below; these aliases are retained for future API
# outbox-dispatch wiring.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
HEALTHCARE_WORKER_SERVICE_NAME=healthcare-worker
HEALTHCARE_WORKER_ENVIRONMENT=development
HEALTHCARE_WORKER_BROKER_URL=redis://localhost:6379/0
HEALTHCARE_WORKER_RESULT_BACKEND_URL=redis://localhost:6379/1
HEALTHCARE_WORKER_EVENT_VERSION=1
HEALTHCARE_WORKER_MAX_RETRIES=5
HEALTHCARE_WORKER_RETRY_BASE_DELAY_SECONDS=5
HEALTHCARE_WORKER_RETRY_MAX_DELAY_SECONDS=900
HEALTHCARE_WORKER_RETRY_JITTER_SECONDS=3
HEALTHCARE_WORKER_TASK_QUEUE=healthcare-worker

# ---------------------------------------------------------------------------
# Optional integrations (degraded mode is valid when blank)
# ---------------------------------------------------------------------------
# Current worker defaults to deterministic fake adapters. Blank values must
# leave booking/visit state usable and expose a pending/failed integration state.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
LLM_PROMPT_VERSION=pre_visit_summary.v1
LLM_SCHEMA_VERSION=clinical_summary.v1

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@example.invalid
SENDGRID_TEMPLATE_PREFIX=healthcare

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events

# Local-only switch used by a human operator when loading infra/seed-demo.sql.
# It is documentation metadata today; no process enables it automatically.
SEED_DEMO_DATA=false
